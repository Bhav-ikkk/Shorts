  "lines": [
    { "id": "L1", "who": "PIP", "text": "In this town, when the streetlamp turns red... freeze!", "spoken": "In this town, when the streetlamp turns red, freeze!", "pause": 0.35 },
    { "id": "L2", "who": "MOX", "text": "Wait, it just turned bright glowing red!", "spoken": "Wait, it just turned bright glowing red!", "pause": 0.25 },
    { "id": "L3", "who": "PIP", "text": "Do not move a single blocky muscle!", "pause": 0.30 },
    { "id": "L4", "who": "MOX", "text": "Pip, my left foot is shaking so bad!", "pause": 0.25 },
    { "id": "L5", "who": "PIP", "text": "Hold still! The town legend says we freeze forever!", "pause": 0.30 },
    { "id": "L6", "who": "MOX", "text": "Now my nose is starting to itch too!", "pause": 0.25 },
    { "id": "L7", "who": "PIP", "text": "Wait... who is that walking past the trees?!", "pause": 0.30 },
    { "id": "L8", "who": "JUNE", "text": "Hey guys, what are you two doing?", "pause": 0.30 },
    { "id": "L9", "who": "PIP", "text": "June, run! The red streetlamp curse is active!", "pause": 0.30 },
    { "id": "L10", "who": "JUNE", "text": "There is no curse, you silly blocks.", "pause": 0.30 },
    { "id": "L11", "who": "MOX", "text": "Then why is the park lamp glowing red?!", "pause": 0.25 },
    { "id": "L12", "who": "JUNE", "text": "I just taped my red candy wrapper inside!", "pause": 0.35 },
    { "id": "L13", "who": "PIP", "text": "Ten minutes frozen... for a candy wrapper?!", "pause": 0.35 },
    { "id": "L14", "who": "JUNE", "text": "Wait until you see what neon green does!", "pause": 0.45 }
