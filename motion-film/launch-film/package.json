{
  "name": "@spectra/launch-film",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts SpectraLaunchFilm ../../out/spectra-x-intro.mp4",
    "render:x": "remotion render src/index.ts SpectraXFeed ../../out/spectra-x-feed.mp4 --codec=h264",
    "thumbnail": "remotion still src/index.ts SpectraLaunchFilm ../../out/spectra-x-intro-thumbnail.png --frame=470"
  },
  "dependencies": {
    "@remotion/media-utils": "4.0.540",
    "lucide-react": "^1.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.540",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.3"
  }
}
